"},"children":[]}]},{"data":{"id":"m11_caz686ijvc80","created":1619594196746,"text":"事务","expandState":"expand"},"children":[{"data":{"id":"m11_caz6hzvlf3s0","created":1619594965939,"text":"事务概述 "},"children":[]},{"data":{"id":"m11_caz6i49pbvk0","created":1619594975499,"text":"事务的实现 "},"children":[]},{"data":{"id":"m11_caz6i7z292o0","created":1619594983563,"text":"事务控制语句 "},"children":[]},{"data":{"id":"m11_caz6icemtio0","created":1619594993211,"text":"隐式提交的SQL语句 "},"children":[]},{"data":{"id":"m11_caz6igms9yg0","created":1619595002411,"text":"对于事务操作的统计 "},"children":[]},{"data":{"id":"m11_caz6ikbm1nk0","created":1619595010443,"text":"事务的隔离级别 "},"children":[]},{"data":{"id":"m11_caz6inqj2zk0","created":1619595017875,"text":"分布式事务 "},"children":[]},{"data":{"id":"m11_caz6iri0ic80","created":1619595026067,"text":"不好的事务习惯 "},"children":[]},{"data":{"id":"m11_caz6ivyre8w0","created":1619595035787,"text":"小结 "},"children":[]}]},{"data":{"id":"m11_caz689idlz40","created":1619594203266,"text":"备份和恢复","expandState":"expand"},"children":[{"data":{"id":"m11_caz6klnx2kw0","created":1619595170092,"text":"备份与恢复概述"},"children":[]},{"data":{"id":"m11_caz6ko142ao0","created":1619595175244,"text":"冷备 "},"children":[]},{"data":{"id":"m11_caz6kq1hxjs0","created":1619595179620,"text":"逻辑备份 "},"children":[]},{"data":{"id":"m11_caz6s1ns44o0","created":1619595753461,"text":"二进制日志备份与恢复 "},"children":[]},{"data":{"id":"m11_caz6s8942nc0","created":1619595767812,"text":"热备 "},"children":[]},{"data":{"id":"m11_caz6sd0zfpk0","created":1619595778204,"text":"快照备份 "},"children":[]},{"data":{"id":"m11_caz6shn0rq00","created":1619595788244,"text":"复制 "},"children":[]},{"data":{"id":"m11_caz6sl1e8qw0","created":1619595795644,"text":"小结 "},"children":[]}]},{"data":{"id":"m11_caz68etao800","created":1619594214810,"text":"性能调优","expandState":"expand"},"children":[{"data":{"id":"m11_caz6sqknezs0","created":1619595807692,"text":"选择合适的CPU "},"children":[]},{"data":{"id":"m11_caz6sues2ns0","created":1619595816044,"text":"内存的重要性 "},"children":[]},{"data":{"id":"m11_caz6sy9ozbk0","created":1619595824444,"text":"硬盘对数据库性能的影响 "},"children":[]},{"data":{"id":"m11_caz6t1mr5pk0","created":1619595831764,"text":"合理地设置RAID "},"children":[]},{"data":{"id":"m11_caz6t4rcpi00","created":1619595838572,"text":"操作系统的选择也很重要 "},"children":[]},{"data":{"id":"m11_caz6t7s4gmg0","created":1619595845149,"text":"不同的文件系统对数据库性能的影响 "},"children":[]},{"data":{"id":"m11_caz6tbp9shs0","created":1619595853684,"text":"选择合适的基准测试工具 "},"children":[]}]},{"data":{"id":"m11_caz68k5ey7c0","created":1619594226427,"text":"innoDB存储引擎代码的编译和调试","expandState":"expand"},"children":[{"data":{"id":"m11_caz6tlhhbrc0","created":1619595874980,"text":"获取InnoDB存储引擎源代码 "},"children":[]},{"data":{"id":"m11_caz6toxfuo80","created":1619595882476,"text":"InnoDB源代码结构 "},"children":[]},{"data":{"id":"m11_caz6tskywuo0","created":1619595890429,"text":"编译和调试InnoDB源代码 "},"children":[]},{"data":{"id":"m11_caz6twkiqhk0","created":1619595899109,"text":"Windows下的调试 "},"children":[]},{"data":{"id":"m11_caz6tzt38x40","created":1619595906157,"text":"Linux下的调试 "},"children":[]},{"data":{"id":"m11_caz6u391sq00","created":1619595913653,"text":"小结 "},"children":[]}]}]},{"data":{"id":"m12_574603aa0e62","created":1619487295,"text":"索引简单总结","expandState":"collapse"},"children":[{"data":{"id":"m12_cayyeyfrods0","created":1619572158833,"text":"按表列属性分类"},"children":[{"data":{"id":"m12_caz1cita3c80","created":1619580431423,"text":"单列索引"},"children":[{"data":{"id":"m12_caz1nh1wwzs0","created":1619581289597,"text":"以表的单个列字段创建的索引"},"children":[]}]},{"data":{"id":"m12_caz1cltptn40","created":1619580437980,"text":"联合索引","expandState":"expand"},"children":[{"data":{"id":"m12_caz1nlp07rc0","created":1619581299701,"text":"以表的多个列字段组合创建的索引，在查询条件使用索引的从左字段顺序才会生效，遵循最左匹配原则"},"children":[]},{"data":{"id":"m12_caz1coeuafk0","created":1619580443611,"text":"普通索引","expandState":"collapse"},"children":[{"data":{"id":"m12_caz1rrjmebs0","created":1619581625893,"text":"非主键，非唯一列的索引"},"children":[]},{"data":{"id":"m12_caz3gioiq3k0","created":1619586386812,"text":"特点：加速查找"},"children":[]}]},{"data":{"id":"m12_caz1cqt3rvk0","created":1619580448827,"text":"主键索引","expandState":"collapse"},"children":[{"data":{"id":"m12_caz1rwf7d9k0","created":1619581636509,"text":"基于该表主键自动生成成的索引，如果未给表定义主键，会查找该表中是否存在非空、整形、唯一索引作为其主键(可通过select _rowid from 表名查看)，若都不满足会隐式生成一个rowid作为主键(无法直接查到)"},"children":[]},{"data":{"id":"m12_caz3gpy2e1c0","created":1619586402627,"text":"特点：加速查找 + 不能为空 + 不能重复"},"children":[]}]},{"data":{"id":"m12_caz1ct03obs0","created":1619580453603,"text":"唯一索引","expandState":"collapse"},"children":[{"data":{"id":"m12_caz1rz9lsmg0","created":1619581642701,"text":"基于表的唯一列生成的索引，允许为空值"},"children":[]},{"data":{"id":"m12_caz3gvzgegw0","created":1619586415771,"text":"特点：加速查找 + 不能重复"},"children":[]}]},{"data":{"id":"m12_caz1cx192nk0","created":1619580462380,"text":"全文索引","expandState":"expand"},"children":[{"data":{"id":"m12_caz1s29os8o0","created":1619581649237,"text":"将存储于数据库中的整本书或整篇文章中任意内容信息查找出来，如大量级的文字中如like %关键字%，普通索引的效率与全文索引相比是非常低的。"},"children":[]}]}]}]},{"data":{"id":"m12_cayyl3hf2hs0","created":1619572640002,"text":"按数据结构分类"},"children":[{"data":{"id":"m12_caz1dmakuxc0","created":1619580517364,"text":"hash","expandState":"expand"},"children":[{"data":{"id":"m12_caz1timnyp40","created":1619581763214,"text":"　　b+tree基于平衡二叉树的一种多路平衡查找树，所有记录都按照顺序存放在叶子节点中，各个叶子节点直接通过链表相连。与b树不同的是：\n　　非叶子节点只存储键值信息。\n　　所有叶子节点之间都有一个链指针。\n　　数据记录都存放在叶子节点中"},"children":[]}]},{"data":{"id":"m12_caz1dpsswjc0","created":1619580524996,"text":"hash","expandState":"expand"},"children":[{"data":{"id":"m12_caz1ttnu5cw0","created":1619581787229,"text":"基于hash表结构实现的索引，mysql中只有MEMORY/HEAP和NDB存储引擎支持;\n　　InnoDB引擎支持自适应hash索引，但是是数据库自身创建使用的，而不能进行人为定义。当二级索引被频繁的访问时，便会自动创建自适应哈希索引;\n　　通过 命令SHOW ENGINE INNODB STATUS可查看自适应hash索引的使用情况;\n　　通过 命令SHOW VARIABLES LIKE '%ap%hash_index' 查看是否打开自适应hash索引。\n　　对比：\n　　由于hash索引是比较其hash值，hash索引只能进行等值查找而不能进行范围查找\n　　hash索引无法进行排序：原因同上\n　　不支持最左匹配原则，复合索引时合并一起计算hash值\n　　hash索引的检索效率很高可以一次定位，但是当发生大量hash碰撞的时候，链表变长，hash索引效率上是不如b+tree的\n　　由于存在hash碰撞的问题，当需要获得总数时候，hash 索引在任何时候都不能避免表扫描"},"children":[]}]},{"data":{"id":"m12_caz1e0ewl080","created":1619580548100,"text":"T-tree "},"children":[]},{"data":{"id":"m12_caz1ebbkt2g0","created":1619580571844,"text":"R-tree(空间索引)"},"children":[]}]},{"data":{"id":"m12_cayylv8l69c0","created":1619572700418,"text":"按存储结构分类","expandState":"expand"},"children":[{"data":{"id":"m12_caz1ef6ig680","created":1619580580244,"text":"聚簇索引(聚集索引)","expandState":"expand"},"children":[{"data":{"id":"m12_caz1u1wlhuw0","created":1619581805173,"text":"InnoDB的聚簇索引实际上是在同一个BTree结构中同时存储了索引和整行数据，通过该索引查询可以直接获取查询数据行。\n　　聚簇索引不是一种单独的索引类型，而是一种数据的存储方式，聚簇索引的顺序，就是数据在硬盘上的物理顺序。\n　　在mysql通常聚簇索引是主键的同义词，每张表只包含一个聚簇索引(其他数据库不一定)"},"children":[]},{"data":{"id":"m12_caz1uilnb6g0","created":1619581841517,"text":"聚簇索引的优点"},"children":[{"data":{"id":"m12_caz1ulsw2cg0","created":1619581848485,"text":"可以把相关数据保存在一起，如：实现电子邮箱时，可以根据用户ID来聚集数据，这样只需要从磁盘读取少量的数据页就能获取某个用户全部邮件，如果没有使用聚集索引，则每封邮件都可能导致一次磁盘IO\n　　数据访问更快，聚集索引将索引和数据保存在同一个btree中，因此从聚集索引中获取数据通常比在非聚集索引中查找要快\n　　使用覆盖索引扫描的查询可以直接使用页节点中的主键值"},"children":[]}]},{"data":{"id":"m12_caz1upi95740","created":1619581856549,"text":"聚簇索引的缺点"},"children":[{"data":{"id":"m12_caz1v14ctv40","created":1619581881830,"text":"　聚簇数据最大限度地提高了IO密集型应用的性能，但如果数据全部放在内存中，则访问的顺序就没有那么重要了，聚集索引也没有什么优势了\n　　插入速度严重依赖于插入顺序，按照主键的顺序插入是加载数据到innodb表中速度最快的方式，但如果不是按照主键顺序加载数据，那么在加载完成后最好使用optimize table命令重新组织一下表\n　　更新聚集索引列的代价很高，因为会强制innodb将每个被更新的行移动到新的位置\n　　基于聚集索引的表在插入新行，或者主键被更新导致需要移动行的时候，可能面临页分裂的问题，当行的主键值要求必须将这一行插入到某个已满的页中时，存储引擎会将该页分裂成两个页面来容纳该行，这就是一次页分裂操作，页分裂会导致表占用更多的磁盘空间\n　　聚集索引可能导致全表扫描变慢，尤其是行比较稀疏，或者由于页分裂导致数据存储不连续的时候\n　　二级索引可能比想象的更大，因为在二级索引的叶子节点包含了引用行的主键列。\n　　二级索引访问需要两次索引查找，而不是一次"},"children":[]}]}]},{"data":{"id":"m12_caz1elpgyr40","created":1619580594452,"text":"辅助索引(非聚集索引，次级索引，二级索引)","layout_right_offset":{"x":22,"y":52},"expandState":"expand"},"children":[{"data":{"id":"m12_caz1udi9yfc0","created":1619581830429,"text":"非聚集索引在BTree的叶子节点中保存了索引列和主键。如果查询列不在该索引内，只能查到其主键值，还需要回表操作查询聚簇索引进行查询。"},"children":[]}]}]}]},{"data":{"id":"m13_d8d9b2965b59","created":1619678726,"text":"数据库索引设计与优化","expandState":"collapse"},"children":[{"data":{"id":"m13_cb007doke1s0","created":1619678767280,"text":"概述"},"children":[]},{"data":{"id":"m13_cb007h3qe800","created":1619678774728,"text":"表和索引"},"children":[]},{"data":{"id":"m13_cb007o80rzs0","created":1619678790224,"text":"sql处理过程"},"children":[]},{"data":{"id":"m13_cb007v315a80","created":1619678805160,"text":"为selete语句创建理想的索引"},"children":[]},{"data":{"id":"m13_cb0086qtz680","created":1619678830544,"text":"前瞻性的索引设计"},"children":[]},{"data":{"id":"m13_cb008sn3dt40","created":1619678878208,"text":"影响索引设计过程的因素"},"children":[]},{"data":{"id":"m13_cb0091tbvhs0","created":1619678898175,"text":"被动索引设计"},"children":[]},{"data":{"id":"m13_cb00a26cqi80","created":1619678977327,"text":"为表连接设计索引"},"children":[]},{"data":{"id":"m13_cb00aa18xu80","created":1619678994432,"text":"星型连接"},"children":[]},{"data":{"id":"m13_cb00aiado8w0","created":1619679012399,"text":"多索引访问"},"children":[]},{"data":{"id":"m13_cb00aoz5ux40","created":1619679026958,"text":"索引和索引重组"},"children":[]},{"data":{"id":"m13_cb00ayqkdpk0","created":1619679048206,"text":"数据库管理系统相关的索引的限制"},"children":[]},{"data":{"id":"m13_cb00bepuhh40","created":1619679082991,"text":"数据库索引选项"},"children":[]},{"data":{"id":"m13_cb00bm4uo340","created":1619679099136,"text":"优化器不是完美的"},"children":[]},{"data":{"id":"m13_cb00bvvpoy80","created":1619679120351,"text":"其他评估事项"},"children":[]},{"data":{"id":"m13_cb00c48ooxs0","created":1619679138550,"text":"组织索引设计过程"},"children":[]}]},{"data":{"id":"m14_15d536b6b937","created":1644205244,"text":"redis","expandState":"collapse"},"children":[{"data":{"id":"m14_chpi4xfxlls0","created":1644205304737,"text":"Redis基础"},"children":[{"data":{"id":"m14_chpi54bt0ww0","created":1644205319725,"text":"数据结构\nString、Hash、List、Set、SortedSet"},"children":[{"data":{"id":"m14_chpi5flq7z40","created":1644205344269,"text":"HyperLogLog、Geo、Pub/Sub loomFilter，RedisSearch，Redis-ML"},"children":[]}]},{"data":{"id":"m14_chpi6dc60cw0","created":1644205417702,"text":"避免缓存击穿的利器BloomFilter（布隆过滤器）"},"children":[]},{"data":{"id":"m14_chpi8zqki740","created":1644205623190,"text":"Redis分布式锁"},"children":[{"data":{"id":"m14_chpi9886ay80","created":1644205641669,"text":"先拿setnx来争抢锁，抢到之后，再用expire给锁加一个过期时间防止锁忘记了释放。"},"children":[{"data":{"id":"m14_chpi9ijach40","created":1644205664109,"text":"进程意外crash或者要重启维护了把setnx和expire合成一条指令来用的"},"children":[]}]}]},{"data":{"id":"m14_chpiahib7y80","created":1644205740237,"text":"Redis做异步队列么"},"children":[{"data":{"id":"m14_chpiavochv40","created":1644205771077,"text":"一般使用list结构作为队列，rpush生产消息，lpop消费消息。当lpop没有消息的时候，要适当sleep一会再重试"},"children":[]},{"data":{"id":"m14_chpib8503kg0","created":1644205798205,"text":"不用sleep呢？list还有个指令叫blpop，在没有消息的时候，它会阻塞住直到消息到来"},"children":[]},{"data":{"id":"m14_chpibox8eso0","created":1644205834741,"text":"能不能生产一次消费多次呢？\n使用pub/sub主题订阅者模式，可以实现 1:N 的消息队列"},"children":[]},{"data":{"id":"m14_chpibz65h1k0","created":1644205857048,"text":" pub/su b有什么缺点？\n在消费者下线的情况下，生产的消息会丢失，得使用专业的消息队列如RocketMQ等"},"children":[]},{"data":{"id":"m14_chpick8hg4w0","created":1644205902901,"text":"Redis如何实现延时队列？"},"children":[{"data":{"id":"m14_chpicvh2nr40","created":1644205927365,"text":"使用sortedset，拿时间戳作为score，消息内容作为key调用zadd来生产消息，消费者用zrangebyscore指令获取N秒之前的数据轮询进行处理"},"children":[]}]}]},{"data":{"id":"m14_chpicizcv8g0","created":1644205900173,"text":"Redis是怎么持久化"},"children":[{"data":{"id":"m14_chpiqzoigaw0","created":1644207033621,"text":"AOF做增量持久化。因为RDB会耗费较长时间，不够实时大量丢失数据，所以需要AOF来配合使用"},"children":[]}]},{"data":{"id":"m14_chpirr0ghjk0","created":1644207093116,"text":"Pipeline有什么好处"},"children":[{"data":{"id":"m14_chpisae5wig0","created":1644207135304,"text":"可以将多次IO往返的时间缩减为一次，前提是pipeline执行的指令之间没有因果相关性"},"children":[]}]},{"data":{"id":"m14_chpmlzmjl280","created":1644217926120,"text":"Redis集群"},"children":[{"data":{"id":"m14_chpmmeaapwg0","created":1644217958032,"text":"Redis Sentinal 着眼于高可用，在master宕机时会自动将slave提升为master，继续提供服务"},"children":[]},{"data":{"id":"m14_chpmmj88ayo0","created":1644217968791,"text":"Redis Cluster 着眼于扩展性，在单个redis内存不足时，使用Cluster进行分片存储。"},"children":[]}]}]},{"data":{"id":"m14_chpmo3xg1ww0","created":1644218092215,"text":"系列-缓存雪崩、击穿、穿透"},"children":[{"data":{"id":"m14_chpmorplh0w0","created":1644218143983,"text":"雪崩"},"children":[{"data":{"id":"m14_chpmp6ks24w0","created":1644218176344,"text":"如果所有首页的Key全部失效，批量往Redis存数据的时候，把每个Key的失效时间都加个随机值就好了","layout_right_offset":{"x":53.00000078976154,"y":0}},"children":[]}]},{"data":{"id":"m14_chpmqk5avow0","created":1644218284247,"text":"缓存穿透是指缓存和数据库中都没有的数据"},"children":[{"data":{"id":"m14_chpmrlnc7sw0","created":1644218365879,"text":"业务校验id自增的话大于id最大值的直接返回，"},"children":[]},{"data":{"id":"m14_chpmudcsc1k0","created":1644218582919,"text":"Redis还有一个高级用法布隆过滤器（Bloom Filter）这个也能很好的防止缓存穿透的发生"},"children":[]}]},{"data":{"id":"m14_chpmvhwiiuw0","created":1644218671183,"text":"缓存击穿"},"children":[{"data":{"id":"m14_chpmvlwgkfs0","created":1644218679887,"text":"设置热点数据永远不过期。或者加上互斥锁就能搞定了"},"children":[]}]}]},{"data":{"id":"m14_chpmxn37eow0","created":1644218839200,"text":"Redis哨兵、持久化、主从、手撕LRU","expandState":"expand"},"children":[{"data":{"id":"m14_chpmzjjn1nk0","created":1644218988215,"text":"redis的他是单线程的，但是，我们可以通过在单机开多个Redis实例嘛","layout_right_offset":{"x":37.000000551342964,"y":0}},"children":[]},{"data":{"id":"m14_chpn0e1wnmw0","created":1644219054623,"text":"我们用到了集群的部署方式也就是Redis cluster，并且是主从同步读写分离，类似Mysql的主从同步，Redis cluster 支撑 N 个 Redis master node，每个master node都可以挂载多个 slave node","expandState":"expand","layout_right_offset":{"x":20,"y":7}},"children":[]},{"data":{"id":"m14_chpn1nv3d9c0","created":1644219154343,"text":"RDB：RDB 持久化机制，是对 Redis 中的数据执行周期性的持久化。\nAOF：AOF 机制对每条写入命令作为日志，以 append-only 的模式写入一个日志文件中，因为这个模式是只追加的方式，所以没有任何磁盘寻址的开销，所以很快，有点像Mysql中的binlog"},"children":[]}]}]},{"data":{"text":"计算机网络","expandState":"collapse"},"children":[{"data":{"text":"传输层","expandState":"collapse"},"children":[{"data":{"text":"运输层协议概述"},"children":[{"data":{"text":"进程之间的通信"},"children":[{"data":{"text":"运输层向它上面的应用层提供通信服务，它属于面向通信部分的最高层，同时也是用户功能中的最低层。"},"children":[]},{"data":{"text":"两个主机进行通信实际上就是两个主机中的应用进程互相通信。"},"children":[]},{"data":{"text":"应用进程之间的通信又称为端到端的通信。"},"children":[]},{"data":{"text":"运输层协议和网络层协议的主要区别"},"children":[]}]},{"data":{"text":"运输层的两个主要协议"},"children":[{"data":{"text":"(1) 用户数据报协议 UDP(User Datagram Protocol)"},"children":[{"data":{"text":"UDP 传送的数据单位协议是 UDP 报文或用户数据报。"},"children":[]}]},{"data":{"text":"(2) 传输控制协议 TCP(Transmission Control Protocol)"},"children":[{"data":{"text":"TCP 传送的数据单位协议是 TCP 报文段(segment)"},"children":[]}]}]},{"data":{"text":"运输层的端口"},"children":[{"data":{"text":"软件端口与硬件端口"},"children":[{"data":{"text":"在协议栈层间的抽象的协议端口是软件端口。"},"children":[]},{"data":{"text":"路由器或交换机上的端口是硬件端口。"},"children":[]}]},{"data":{"text":"三类端口"},"children":[{"data":{"text":"熟知端口，数值一般为 0~1023。"},"children":[]},{"data":{"text":"登记端口号，数值为1024~49151，为没有熟知端口号的应用程序使用的。使用这个范围的端口号必须在 IANA 登记，以防止重复。"},"children":[]},{"data":{"text":"客户端口号或短暂端口号，数值为49152~65535，留给客户进程选择暂时使用。当服务器进程收到客户进程的报文时，就知道了客户进程所使用的动态端口号。通信结束后，这个端口号可供其他客户进程以后使用。"},"children":[]}]}]}]},{"data":{"text":"用户数据报协议 UDP"},"children":[{"data":{"text":"UDP 概述"},"children":[{"data":{"text":"用户数据报协议 UDP（User Datagram Protocol）是无连接的，尽最大可能交付，没有拥塞控制，面向报文（对于应用程序传下来的报文不合并也不拆分，只是添加 UDP 首部），支持一对一、一对多、多对一和多对多的交互通信。"},"children":[]}]},{"data":{"text":"UDP 的首部格式"},"children":[]}]},{"data":{"text":"传输控制协议 TCP 概述"},"children":[{"data":{"text":"TCP 最主要的特点"},"children":[{"data":{"text":"传输控制协议 TCP（Transmission Control Protocol）是面向连接的，提供可靠交付，有流量控制，拥塞控制，提供全双工通信，面向字节流（把应用层传下来的报文看成字节流，把字节流组织成大小不等的数据块），每一条 TCP 连接只能是点对点的（一对一）。"},"children":[]}]},{"data":{"text":"TCP 的连接"},"children":[{"data":{"text":"TCP 连接的端点叫做套接字(socket)或插口。"},"children":[{"data":{"text":"套接字 socket = (IP地址: 端口号)"},"children":[]}]}]}]},{"data":{"text":"可靠传输的工作原理"},"children":[{"data":{"text":"停止等待协议"},"children":[]},{"data":{"text":"连续 ARQ 协议"},"children":[]}]},{"data":{"text":"TCP 报文段的首部格式"},"children":[{"data":{"text":"示意图"},"children":[]}]},{"data":{"text":"TCP 可靠传输的实现","expandState":"collapse"},"children":[{"data":{"text":"以字节为单位的滑动窗口"},"children":[{"data":{"text":"窗口是缓存的一部分，用来暂时存放字节流。发送方和接收方各有一个窗口，接收方通过 TCP 报文段中的窗口字段告诉发送方自己的窗口大小，发送方根据这个值和其它信息设置自己的窗口大小。\n\n发送窗口内的字节都允许被发送，接收窗口内的字节都允许被接收。如果发送窗口左部的字节已经发送并且收到了确认，那么就将发送窗口向右滑动一定距离，直到左部第一个字节不是已发送并且已确认的状态；接收窗口的滑动类似，接收窗口左部字节已经发送确认并交付主机，就向右滑动接收窗口。\n\n接收窗口只会对窗口内最后一个按序到达的字节进行确认，例如接收窗口已经收到的字节为 {31, 34, 35}，其中 {31} 按序到达，而 {34, 35} 就不是，因此只对字节 31 进行确认。发送方得到一个字节的确认之后，就知道这个字节之前的所有字节都已经被接收。"},"children":[{"data":{"text":"1"},"children":[]},{"data":{"text":"2"},"children":[]},{"data":{"text":"3"},"children":[]},{"data":{"text":"4"},"children":[]}]}]},{"data":{"text":"超时重传时间的选择"},"children":[{"data":{"text":"超时重传"},"children":[{"data":{"text":"TCP 使用超时重传来实现可靠传输：如果一个已经发送的报文段在超时时间内没有收到确认，那么就重传这个报文段。\n\n一个报文段从发送再到接收到确认所经过的时间称为往返时间 RTT，加权平均往返时间 RTTs 计算如下："},"children":[]},{"data":{"text":"其中，0 ≤ a ＜ 1，RTTs 随着 a 的增加更容易受到 RTT 的影响。\n\n超时时间 RTO 应该略大于 RTTs，TCP 使用的超时时间计算如下：（其中 RTTd 为偏差的加权平均值）"},"children":[]}]}]},{"data":{"text":"选择确认 SACK"},"children":[]}]},{"data":{"text":"TCP的流量控制"},"children":[{"data":{"text":"利用滑动窗口实现流量控制"},"children":[{"data":{"text":"TCP 流量控制"},"children":[{"data":{"text":"流量控制是为了控制发送方发送速率，保证接收方来得及接收。\n\n接收方发送的确认报文中的窗口字段可以用来控制发送方窗口大小，从而影响发送方的发送速率。将窗口字段设置为 0，则发送方不能发送数据。"},"children":[]}]},{"data":{"text":"流量控制举例"},"children":[]}]},{"data":{"text":"必须考虑传输效率"},"children":[]}]},{"data":{"text":"TCP 的拥塞控制"},"children":[{"data":{"text":"拥塞控制的一般原理"},"children":[{"data":{"text":"如果网络出现拥塞，分组将会丢失，此时发送方会继续重传，从而导致网络拥塞程度更高。因此当出现拥塞时，应当控制发送方的速率。这一点和流量控制很像，但是出发点不同。流量控制是为了让接收方能来得及接收，而拥塞控制是为了降低整个网络的拥塞程度。"},"children":[]},{"data":{"text":"拥塞控制所起的作用"},"children":[]}]},{"data":{"text":"几种拥塞控制方法"},"children":[{"data":{"text":"TCP 主要通过四个算法来进行拥塞控制：慢开始、拥塞避免、快重传、快恢复。"},"children":[{"data":{"text":"发送方需要维护一个叫做拥塞窗口（cwnd）的状态变量，注意拥塞窗口与发送方窗口的区别：拥塞窗口只是一个状态变量，实际决定发送方能发送多少数据的是发送方窗口。\n\n为了便于讨论，做如下假设：\n\n接收方有足够大的接收缓存，因此不会发生流量控制；\n虽然 TCP 的窗口基于字节，但是这里设窗口的大小单位为报文段。"},"children":[]},{"data":{"text":"1. 慢开始与拥塞避免"},"children":[{"data":{"text":"发送的最初执行慢开始，令 cwnd = 1，发送方只能发送 1 个报文段；当收到确认后，将 cwnd 加倍，因此之后发送方能够发送的报文段数量为：2、4、8 ...\n\n注意到慢开始每个轮次都将 cwnd 加倍，这样会让 cwnd 增长速度非常快，从而使得发送方发送的速度增长速度过快，网络拥塞的可能性也就更高。设置一个慢开始门限 ssthresh，当 cwnd &amp;gt;= ssthresh 时，进入拥塞避免，每个轮次只将 cwnd 加 1。\n\n如果出现了超时，则令 ssthresh = cwnd / 2，然后重新执行慢开始。"},"children":[]}]},{"data":{"text":"2. 快重传与快恢复"},"children":[{"data":{"text":"在接收方，要求每次接收到报文段都应该对最后一个已收到的有序报文段进行确认。例如已经接收到 M1 和 M2，此时收到 M4，应当发送对 M2 的确认。\n\n在发送方，如果收到三个重复确认，那么可以知道下一个报文段丢失，此时执行快重传，立即重传下一个报文段。例如收到三个 M2，则 M3 丢失，立即重传 M3。\n\n在这种情况下，只是丢失个别报文段，而不是网络拥塞。因此执行快恢复，令 ssthresh = cwnd / 2 ，cwnd = ssthresh，注意到此时直接进入拥塞避免。\n\n慢开始和快恢复的快慢指的是 cwnd 的设定值，而不是 cwnd 的增长速率。慢开始 cwnd 设定为 1，而快恢复 cwnd 设定为 ssthresh。"},"children":[]}]}]}]},{"data":{"text":"随机早期检测 RED"},"children":[]}]},{"data":{"text":"TCP 的运输连接管理","expandState":"collapse"},"children":[{"data":{"text":"TCP 的连接建立"},"children":[{"data":{"text":"假设 A 为客户端，B 为服务器端。\n\n首先 B 处于 LISTEN（监听）状态，等待客户的连接请求。\n\nA 向 B 发送连接请求报文，SYN=1，ACK=0，选择一个初始的序号 x。\n\nB 收到连接请求报文，如果同意建立连接，则向 A 发送连接确认报文，SYN=1，ACK=1，确认号为 x+1，同时也选择一个初始的序号 y。\n\nA 收到 B 的连接确认报文后，还要向 B 发出确认，确认号为 y+1，序号为 x+1。\n\nB 收到 A 的确认后，连接建立。"},"children":[]},{"data":{"text":"三次握手的原因"},"children":[{"data":{"text":"第三次握手是为了防止失效的连接请求到达服务器，让服务器错误打开连接。\n\n客户端发送的连接请求如果在网络中滞留，那么就会隔很长一段时间才能收到服务器端发回的连接确认。客户端等待一个超时重传时间之后，就会重新请求连接。但是这个滞留的连接请求最后还是会到达服务器，如果不进行三次握手，那么服务器就会打开两个连接。如果有第三次握手，客户端会忽略服务器之后发送的对滞留连接请求的连接确认，不进行第三次握手，因此就不会再次打开连接。"},"children":[]}]}]},{"data":{"text":"TCP 的连接释放"},"children":[{"data":{"text":"以下描述不讨论序号和确认号，因为序号和确认号的规则比较简单。并且不讨论 ACK，因为 ACK 在连接建立之后都为 1。\n\nA 发送连接释放报文，FIN=1。\n\nB 收到之后发出确认，此时 TCP 属于半关闭状态，B 能向 A 发送数据但是 A 不能向 B 发送数据。\n\n当 B 不再需要连接时，发送连接释放报文，FIN=1。\n\nA 收到后发出确认，进入 TIME-WAIT 状态，等待 2 MSL（最大报文存活时间）后释放连接。\n\nB 收到 A 的确认后释放连接。"},"children":[]},{"data":{"text":"四次挥手的原因"},"children":[{"data":{"text":"客户端发送了 FIN 连接释放报文之后，服务器收到了这个报文，就进入了 CLOSE-WAIT 状态。这个状态是为了让服务器端发送还未传送完毕的数据，传送完毕之后，服务器会发送 FIN 连接释放报文。"},"children":[]}]},{"data":{"text":"TIME_WAIT"},"children":[{"data":{"text":"客户端接收到服务器端的 FIN 报文后进入此状态，此时并不是直接进入 CLOSED 状态，还需要等待一个时间计时器设置的时间 2MSL。这么做有两个理由："},"children":[{"data":{"text":"确保最后一个确认报文能够到达。如果 B 没收到 A 发送来的确认报文，那么就会重新发送连接释放请求报文，A 等待一段时间就是为了处理这种情况的发生。"},"children":[]},{"data":{"text":"等待一段时间是为了让本连接持续时间内所产生的所有报文都从网络中消失，使得下一个新的连接不会出现旧的连接请求报文。"},"children":[]}]}]}]},{"data":{"text":"TCP 的有限状态机"},"children":[{"data":{"text":"粗实线箭头表示对客户进程的正常变迁。\n粗虚线箭头表示对服务器进程的正常变迁。\n另一种细线箭头表示异常变迁。"},"children":[]}]}]}]},{"data":{"text":"网络层","expandState":"collapse"},"children":[{"data":{"text":"概念"},"children":[{"data":{"text":"不同主机提供通信服务"},"children":[]}]},{"data":{"text":"网络层功能"},"children":[{"data":{"text":"异构网络互联"},"children":[]},{"data":{"text":"路由与转发"},"children":[]},{"data":{"text":"拥塞控制"},"children":[{"data":{"text":"开环控制"},"children":[{"data":{"text":"设计之初就考虑到所有拥塞的原因"},"children":[]}]},{"data":{"text":"闭环控制"},"children":[{"data":{"text":"检测网络系统及时控制"},"children":[]}]}]}]},{"data":{"text":"IP数据报"},"children":[{"data":{"text":"格式（首部）"},"children":[{"data":{"text":"首部长度"},"children":[]},{"data":{"text":"总长度"},"children":[]},{"data":{"text":"片偏移"},"children":[]}]},{"data":{"text":"IP数据报分片"},"children":[]}]},{"data":{"text":"IPv4地址"},"children":[{"data":{"text":"分类的IP地址"},"children":[{"data":{"text":"网络地址转换NAT"},"children":[{"data":{"text":"私有IP地址和公共IP地址的转换"},"children":[]}]}]},{"data":{"text":"子网的划分"},"children":[]},{"data":{"text":"无分类编制CIDR"},"children":[{"data":{"text":"构成超网"},"children":[]}]}]},{"data":{"text":"重要协议"},"children":[{"data":{"text":"ARP协议（MAC地址和IP地址的映射）"},"children":[]},{"data":{"text":"DHCP协议（动态获取IP地址）"},"children":[]},{"data":{"text":"ICMP协议"},"children":[{"data":{"text":"ICMP差错报告报文"},"children":[]},{"data":{"text":"ICMP询问报文"},"children":[]}]},{"data":{"text":"IGMP协议+组播路由选择协议"},"children":[]}]},{"data":{"text":"路由算法"},"children":[{"data":{"text":"静态路由算法"},"children":[{"data":{"text":"固定时长的信号波形"},"children":[]}]},{"data":{"text":"动态路由算法"},"children":[{"data":{"text":"链路状态路由算法OSPF"},"children":[]},{"data":{"text":"距离向量路由算法RIP"},"children":[]}]}]},{"data":{"text":"IPv6"},"children":[{"data":{"text":"IPv6诞生原因"},"children":[{"data":{"text":"IPv4地址已经分配殆尽"},"children":[]}]},{"data":{"text":"IPv6数据报格式"},"children":[{"data":{"text":"基本首部"},"children":[{"data":{"text":"版本"},"children":[]},{"data":{"text":"流标签"},"children":[]},{"data":{"text":"优先级"},"children":[]},{"data":{"text":"源地址、目的地址"},"children":[]},{"data":{"text":"下一个首部"},"children":[]},{"data":{"text":"跳数限制"},"children":[]},{"data":{"text":"有效载荷长度"},"children":[]}]},{"data":{"text":"有效载荷"},"children":[{"data":{"text":"扩展首部"},"children":[]},{"data":{"text":"数据"},"children":[]}]}]},{"data":{"text":"IPv6与IPv4不同"},"children":[{"data":{"text":"128位"},"children":[]},{"data":{"text":"校验和字段移除"},"children":[]},{"data":{"text":"扩展首部"},"children":[]},{"data":{"text":"即插即用"},"children":[]},{"data":{"text":"8B的整数倍"},"children":[]}]},{"data":{"text":"IPv6地址表示形式"},"children":[{"data":{"text":"冒号十六进制"},"children":[{"data":{"text":"一般形式"},"children":[]},{"data":{"text":"压缩形式"},"children":[]},{"data":{"text":"零压缩"},"children":[]}]}]},{"data":{"text":"IPv6基本地址类型"},"children":[{"data":{"text":"单播"},"children":[]},{"data":{"text":"多播"},"children":[]},{"data":{"text":"任播"},"children":[]}]},{"data":{"text":"IPv6向IPv4过渡的策略"},"children":[{"data":{"text":"隧道技术"},"children":[]},{"data":{"text":"双栈技术"},"children":[]}]}]},{"data":{"text":"路由选择协议"},"children":[{"data":{"text":"内部网关协议"},"children":[{"data":{"text":"RIP"},"children":[]},{"data":{"text":"OSPF"},"children":[]}]},{"data":{"text":"外部网关协议"},"children":[{"data":{"text":"BGP"},"children":[]}]}]},{"data":{"text":"移动IP"},"children":[{"data":{"text":"相关术语"},"children":[]},{"data":{"text":"通信过程"},"children":[]}]},{"data":{"text":"网络层设备——路由器"},"children":[{"data":{"text":"路由选择"},"children":[]},{"data":{"text":"分组转发"},"children":[]}]}]},{"data":{"text":"数据链路层","expandState":"co